{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/whact2025/POPGP/protocols/POPGP-VIABILITY-R3-2026-08/VIA-000-CONTAINMENT-PROOF-ENVELOPE.schema.json",
  "title": "VIA-000 R3 canonical hosted containment proof envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_kind",
    "identity",
    "members",
    "schema_version",
    "total_decoded_bytes"
  ],
  "properties": {
    "envelope_kind": {"const": "via000-r3-hosted-containment-envelope"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_name", "cell", "event_name", "platform_family", "repository",
        "run_attempt", "run_id", "source_ref", "source_sha", "stage_id",
        "workflow", "workflow_ref"
      ],
      "properties": {
        "artifact_name": {
          "type": "string",
          "pattern": "^via000-r3-containment-proof-(ubuntu-latest-x86_64|windows-x86_64)-(candidate|pdf|mutation)$"
        },
        "cell": {
          "type": "string",
          "pattern": "^(ubuntu-latest-x86_64|windows-x86_64)/(candidate|pdf|mutation)$"
        },
        "event_name": {"const": "push"},
        "platform_family": {"enum": ["ubuntu-latest-x86_64", "windows-x86_64"]},
        "repository": {"const": "whact2025/POPGP"},
        "run_attempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "source_ref": {
          "type": "string",
          "pattern": "^refs/heads/(campaign|review)/via000-r3-protocol-[A-Za-z0-9._/-]+$"
        },
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "stage_id": {"enum": ["candidate", "pdf", "mutation"]},
        "workflow": {"const": ".github/workflows/via000-r3-containment-proof.yml"},
        "workflow_ref": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "members": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containment-result.json", "proof.json", "stderr.txt", "stdout.txt"],
      "properties": {
        "containment-result.json": {"$ref": "#/$defs/member"},
        "proof.json": {"$ref": "#/$defs/member"},
        "stderr.txt": {"$ref": "#/$defs/member"},
        "stdout.txt": {"$ref": "#/$defs/member"}
      }
    },
    "schema_version": {"const": 1},
    "total_decoded_bytes": {"type": "integer", "minimum": 0, "maximum": 524288}
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base64", "sha256", "size"],
      "properties": {
        "base64": {"type": "string", "maxLength": 349528, "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0, "maximum": 262144}
      }
    }
  }
}
