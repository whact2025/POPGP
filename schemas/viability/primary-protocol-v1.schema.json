{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/whact2025/POPGP/schemas/viability/primary-protocol-v1.schema.json",
  "title": "POPGP primary protocol envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "parameters",
    "measurement_procedure",
    "uncertainty_procedure",
    "statistical_analysis",
    "resource_budget",
    "commands",
    "mutation_plan"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"type": "string", "pattern": "^VIA-[0-9]{3}$"},
    "parameters": {"type": "object"},
    "measurement_procedure": {"type": "string", "minLength": 1},
    "uncertainty_procedure": {"type": "string", "minLength": 1},
    "statistical_analysis": {"type": "string", "minLength": 1},
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_seconds", "memory_bytes", "accelerator_seconds"],
      "properties": {
        "wall_time_seconds": {"type": "number", "exclusiveMinimum": 0},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "accelerator_seconds": {"type": "number", "minimum": 0}
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mutation_plan": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
